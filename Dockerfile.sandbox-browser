FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Install Playwright system dependencies, VNC stack, and common tools
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    fonts-liberation \
    fonts-noto-color-emoji \
    git \
    jq \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxshmfence1 \
    novnc \
    python3 \
    socat \
    websockify \
    x11vnc \
    xvfb \
  && rm -rf /var/lib/apt/lists/*

# Install playwright-core and download Chromium via Playwright
# This ensures the same Chromium version that Kirie's browser-tool.ts expects
RUN npm install -g playwright-core \
  && npx playwright-core install chromium \
  && npm cache clean --force

COPY scripts/sandbox-browser-entrypoint.sh /usr/local/bin/kirie-sandbox-browser
RUN chmod +x /usr/local/bin/kirie-sandbox-browser

EXPOSE 9222 5900 6080

CMD ["kirie-sandbox-browser"]
