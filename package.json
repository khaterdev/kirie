{
  "name": "kirie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kirie - Personal AI Assistant powered by Claude Agent SDK",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "daemon": "pnpm --filter @kirie/daemon run start",
    "cli": "pnpm --filter @kirie/cli run start",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
