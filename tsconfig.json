{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Every package builds with tsdown, never with tsc, so tsc is only ever a
    // typechecker here. Keeping noEmit in the shared base makes it impossible
    // for a stray `tsc` to drop .js/.d.ts next to sources, where TS/ESM's .js
    // import extensions would let the bundler resolve them instead of the .ts.
    "noEmit": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "exclude": ["**/node_modules", "**/dist"]
}
