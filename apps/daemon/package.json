{
  "name": "@kirie/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@kirie/core": "workspace:*",
    "@kirie/media": "workspace:*",
    "@kirie/channel-telegram": "workspace:*",
    "@kirie/channel-discord": "workspace:*",
    "@kirie/channel-slack": "workspace:*",
    "@kirie/channel-whatsapp": "workspace:*",
    "@kirie/channel-signal": "workspace:*",
    "@kirie/skills": "workspace:*",
    "@kirie/memory": "workspace:*",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0"
  }
}
